# Copy to .env for local overrides. GitHub Actions sets these in Step 6.
# Full origin of the deployed site
SITE_URL=https://example.github.io
# Repo sub-path on GitHub Pages (e.g. /cv); leave empty or "/" for a root domain
BASE_PATH=
# Contact form endpoint, e.g. https://formspree.io/f/abcdwxyz
# Empty → the form opens the visitor's email app (mailto:) instead
PUBLIC_FORMSPREE_ENDPOINT=
