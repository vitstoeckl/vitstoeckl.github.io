# Copy to .env for local overrides. GitHub Actions sets SITE_URL and BASE_PATH itself.
# Full origin of the deployed site
SITE_URL=https://vitstoeckl.github.io
# Repo sub-path on GitHub Pages (e.g. /cv); leave empty or "/" for a root domain
BASE_PATH=
# Contact form endpoint, e.g. https://formspree.io/f/abcdwxyz
# (on GitHub: Settings → Secrets and variables → Actions → Variables)
# Empty → the form opens the visitor's email app (mailto:) instead
PUBLIC_FORMSPREE_ENDPOINT=
# Umami Cloud "Website ID" (umami.is → Settings → Websites). Empty → no analytics.
PUBLIC_UMAMI_WEBSITE_ID=
# Encrypted Umami share link for /admin — create with: npm run admin:vault
PUBLIC_ADMIN_VAULT=
