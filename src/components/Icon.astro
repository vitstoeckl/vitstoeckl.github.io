---
/**
 * Small inline SVG icons (24×24, currentColor). Decorative (`aria-hidden`):
 * give the parent link/button an accessible name instead.
 */
const icons = {
  'arrow-right': { stroke: true, d: 'M5 12h14M13 6l6 6-6 6' },
  'arrow-up-right': { stroke: true, d: 'M7 17 17 7M8 7h9v9' },
  download: { stroke: true, d: 'M12 4v11M7 10l5 5 5-5M5 20h14' },
  'chevron-down': { stroke: true, d: 'm6 9 6 6 6-6' },
  menu: { stroke: true, d: 'M4 7h16M4 12h16M4 17h16' },
  close: { stroke: true, d: 'M6 6l12 12M18 6 6 18' },
  mail: { stroke: true, d: 'M4 6h16v12H4zM4 7l8 6 8-6' },
  check: { stroke: true, d: 'm5 12.5 4.5 4.5L19 7.5' },
  globe: {
    stroke: true,
    d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z',
  },
  sparkles: {
    stroke: true,
    d: 'M10 3.5 11.6 8 16 9.5 11.6 11 10 15.5 8.4 11 4 9.5 8.4 8zM18 14l.8 2.2L21 17l-2.2.8L18 20l-.8-2.2L15 17l2.2-.8z',
  },
  'map-pin': { stroke: true, d: 'M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21zM12 7.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z' },
  quote: {
    stroke: false,
    d: 'M9.6 6C6.4 7.3 4.5 10 4.5 13.5V18h5.2v-5.2H7.2c.1-2 1.3-3.6 3.3-4.5zm9 0c-3.2 1.3-5.1 4-5.1 7.5V18h5.2v-5.2h-2.5c.1-2 1.3-3.6 3.3-4.5z',
  },
  sun: {
    stroke: true,
    d: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41',
  },
  moon: { stroke: true, d: 'M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z' },
  linkedin: {
    stroke: false,
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  github: {
    stroke: false,
    d: 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57l-.02-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3z',
  },
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
  fill={icon.stroke ? 'none' : 'currentColor'}
  stroke={icon.stroke ? 'currentColor' : 'none'}
  stroke-width={icon.stroke ? 2 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"><path d={icon.d}></path></svg>
