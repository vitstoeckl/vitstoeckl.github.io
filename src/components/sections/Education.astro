---
/**
 * Education (section id "education"): one tile per entry — degree, field, school, dates
 * (with the "expected" suffix for a planned graduation), courses / thesis / GPA when set.
 */
import Tile from '../Tile.astro';
import Chip from '../Chip.astro';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { formatDateRange, pick, t, type Lang } from '../../i18n/utils';
import { education } from '../../data/education';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const newTab = t('a11y.newTab', lang);

function dates(entry: (typeof education)[number]): string {
  const range = formatDateRange(entry.start, entry.end, lang);
  return entry.end && entry.endExpected ? `${range} (${t('date.expected', lang)})` : range;
}
---

{
  education.length > 0 && (
    <section id="education" aria-labelledby="education-title" class="mt-16 sm:mt-20">
      <SectionHeader id="education-title" title={t('section.education', lang)} size="lg" class="mb-6" />
      <ul class="grid gap-4 md:grid-cols-2">
        {education.map((entry, i) => (
          <li data-reveal data-reveal-delay={String(i * 100)} class="flex">
            <Tile class="flex w-full flex-col gap-4">
              <p class="text-sm font-semibold">{dates(entry)}</p>
              <div>
                <h3 class="text-2xl">{pick(entry.degree, lang)}</h3>
                <p class="mt-1 font-semibold text-accent">{pick(entry.field, lang)}</p>
              </div>
              <div class="text-sm text-muted">
                <p class="font-medium text-ink">
                  {entry.schoolUrl ? (
                    <a href={entry.schoolUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                      {entry.school}
                      <span class="sr-only"> {newTab}</span>
                    </a>
                  ) : (
                    entry.school
                  )}
                </p>
                <p class="mt-1 flex items-center gap-1.5">
                  <Icon name="map-pin" size={15} />
                  {pick(entry.location, lang)}
                </p>
              </div>
              {entry.thesis && (
                <p class="text-sm">
                  <span class="font-semibold">{t('education.thesis', lang)}:</span>{' '}
                  <span class="text-muted">{pick(entry.thesis, lang)}</span>
                </p>
              )}
              {entry.gpa && (
                <p class="text-sm">
                  <span class="font-semibold">{t('education.gpa', lang)}:</span> <span class="text-muted">{entry.gpa}</span>
                </p>
              )}
              {entry.courses && entry.courses.length > 0 && (
                <div class="mt-auto border-t border-line pt-4">
                  <h4 class="text-sm font-semibold tracking-normal text-muted">{t('education.courses', lang)}</h4>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {entry.courses.map((course) => (
                      <Chip as="li" class="max-w-full whitespace-normal!">
                        {pick(course, lang)}
                      </Chip>
                    ))}
                  </ul>
                </div>
              )}
            </Tile>
          </li>
        ))}
      </ul>
    </section>
  )
}
