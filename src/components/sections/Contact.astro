---
/**
 * Contact (section id "contact"): large dark tile with email, LinkedIn, GitHub (only if set)
 * and a contact form. With PUBLIC_FORMSPREE_ENDPOINT set (src/config.ts) the form posts to Formspree;
 * otherwise it opens the visitor's email app with the message filled in (mailto:).
 */
import Tile from '../Tile.astro';
import Icon, { type IconName } from '../Icon.astro';
import { t, type Lang } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { formspreeEndpoint } from '../../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const newTab = t('a11y.newTab', lang);

interface Channel {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external: boolean;
}

const channels: Channel[] = [
  { icon: 'mail', label: t('contact.email', lang), value: profile.email, href: `mailto:${profile.email}`, external: false },
  {
    icon: 'linkedin',
    label: 'LinkedIn',
    value: profile.socials.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
    href: profile.socials.linkedin,
    external: true,
  },
  ...(profile.socials.github
    ? [
        {
          icon: 'github' as const,
          label: 'GitHub',
          value: profile.socials.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
          href: profile.socials.github,
          external: true,
        },
      ]
    : []),
];

const mode = formspreeEndpoint ? 'formspree' : 'mailto';
// Without JS: Formspree takes a normal POST; the mailto fallback uses the browser's text/plain mail form.
const formAttrs =
  mode === 'formspree'
    ? { action: formspreeEndpoint, method: 'post' }
    : { action: `mailto:${profile.email}`, method: 'post', enctype: 'text/plain' };
const inputClass =
  'w-full rounded-[18px] border border-white/15 bg-white/[0.06] px-4 py-3 text-base text-tile-dark-ink placeholder:text-tile-dark-muted transition focus:border-accent focus:bg-white/10 focus:outline-none';
---

<section id="contact" aria-labelledby="contact-title" class="mt-16 sm:mt-20">
  <Tile variant="dark" size="lg" class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16 lg:p-14" data-reveal>
    <div class="flex flex-col gap-8">
      <div>
        <h2 id="contact-title" class="text-4xl sm:text-5xl">{t('section.contact', lang)}</h2>
        <p class="mt-4 max-w-[42ch] text-base leading-relaxed text-tile-dark-muted sm:text-[1.0625rem]">
          {t('contact.lead', lang)}
        </p>
      </div>
      <ul class="flex flex-col gap-3">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="group flex items-center gap-4 rounded-[20px] bg-white/[0.06] p-3 pr-5 transition hover:bg-white/10"
              >
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white/10" aria-hidden="true">
                  <Icon name={c.icon} size={20} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-semibold tracking-wide text-tile-dark-muted uppercase">{c.label}</span>
                  <span class="block truncate font-semibold">{c.value}</span>
                </span>
                <Icon name="arrow-up-right" size={18} class="ml-auto opacity-50 transition group-hover:opacity-100" />
                {c.external && <span class="sr-only"> {newTab}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      {...formAttrs}
      data-contact-form
      data-mode={mode}
      data-to={profile.email}
      data-subject={`${t('section.contact', lang)} — ${profile.name}`}
      data-sending={t('form.sending', lang)}
      data-success={t('form.success', lang)}
      data-error={t('form.error', lang)}
      data-fallback={t('form.fallback', lang)}
      class="flex flex-col gap-4"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-2 text-sm font-semibold">
          {t('form.name', lang)}
          <input name="name" type="text" autocomplete="name" required class={inputClass} />
        </label>
        <label class="flex flex-col gap-2 text-sm font-semibold">
          {t('form.email', lang)}
          <input name="email" type="email" autocomplete="email" required class={inputClass} />
        </label>
      </div>
      <label class="flex flex-col gap-2 text-sm font-semibold">
        {t('form.message', lang)}
        <textarea name="message" rows="6" required class:list={[inputClass, 'min-h-40 resize-y']}></textarea>
      </label>
      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="inline-flex h-13 items-center justify-center gap-2 rounded-chip bg-tile-dark-ink px-6 font-semibold text-tile-dark transition hover:opacity-85 disabled:opacity-60"
        >
          <span data-submit-label>{t('form.send', lang)}</span>
          <Icon name="arrow-right" size={18} />
        </button>
        {mode === 'mailto' && <p class="text-sm text-tile-dark-muted">{t('form.fallback', lang)}</p>}
      </div>
      <p data-form-status role="status" aria-live="polite" class="min-h-6 text-sm font-semibold empty:hidden"></p>
    </form>
  </Tile>
</section>

<script>
  import { track } from '../../lib/analytics';

  document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const d = form.dataset;

    function show(text: string, ok: boolean) {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle('text-accent', ok);
      status.classList.toggle('text-red-300', !ok);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      if (d.mode !== 'formspree') {
        track('contact-submit', { via: 'email-app' });
        const subject = `${d.subject}${name ? ` (${name})` : ''}`;
        const body = `${message}\n\n— ${name}${email ? ` <${email}>` : ''}`;
        window.location.href = `mailto:${d.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        show(d.fallback ?? '', true);
        return;
      }

      const idleLabel = submitLabel?.textContent ?? '';
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = d.sending ?? '';
      try {
        const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        track('contact-submit', { via: 'formspree' });
        show(d.success ?? '', true);
      } catch {
        show(d.error ?? '', false);
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = idleLabel;
      }
    });
  });
</script>
