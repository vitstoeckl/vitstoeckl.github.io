---
/**
 * Title row for a tile or a group of tiles, with an optional link on the right (e.g. "All 8 →").
 * `level` picks the heading tag; `size` the visual size (sm = tile title, lg = section title).
 */
interface Props {
  title: string;
  level?: 'h2' | 'h3';
  size?: 'sm' | 'lg';
  linkLabel?: string;
  href?: string;
  id?: string;
  class?: string;
}

const { title, level = 'h2', size = 'sm', linkLabel, href, id, class: className } = Astro.props;
const Heading = level;
---

<div class:list={['flex items-baseline justify-between gap-4', className]}>
  <Heading id={id} class:list={[size === 'lg' ? 'text-3xl sm:text-4xl' : 'text-xl font-semibold tracking-tight']}>
    {title}
  </Heading>
  {
    linkLabel && href && (
      <a href={href} class="shrink-0 text-sm font-semibold text-accent hover:underline">
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
