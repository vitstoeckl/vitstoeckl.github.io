---
/** Status pill with a dot, e.g. "Open to part-time roles". `pulse` animates the dot (not for reduced motion). */
interface Props {
  variant?: 'accent' | 'neutral' | 'onDark';
  dot?: boolean;
  pulse?: boolean;
  class?: string;
}

const { variant = 'accent', dot = true, pulse = false, class: className } = Astro.props;

const variants = {
  accent: 'bg-accent-soft text-accent',
  neutral: 'bg-bg text-muted',
  onDark: 'bg-white/10 text-tile-dark-ink',
};
const dotColor = variant === 'accent' ? 'bg-accent' : 'bg-current';
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-chip px-3.5 py-2 text-[0.8125rem] leading-tight font-semibold',
    variants[variant],
    className,
  ]}
>
  {
    dot && (
      <span class="relative flex size-2 shrink-0">
        {pulse && <span class:list={['absolute inset-0 rounded-full opacity-60 motion-safe:animate-ping', dotColor]} />}
        <span class:list={['relative size-2 rounded-full', dotColor]} />
      </span>
    )
  }
  <span><slot /></span>
</span>
