---
/**
 * `/` → the visitor's language: a saved choice (from the language switcher), else the
 * browser's preferred languages, else English. Without JavaScript: meta refresh to /en/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang, languages, langs } from '../i18n/utils';
import { profile } from '../data/profile';
import { url } from '../lib/url';

const targets = Object.fromEntries(langs.map((lang) => [lang, url(`/${lang}/`)]));
const fallback = targets[defaultLang];
---

<BaseLayout title={profile.name} lang={defaultLang} noindex>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`3; url=${fallback}`} />
  </Fragment>
  <script is:inline define:vars={{ targets, fallback }}>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('lang'); } catch (e) {}
      var wanted = [saved].concat(navigator.languages || [navigator.language]);
      for (var i = 0; i < wanted.length; i++) {
        var code = (wanted[i] || '').toLowerCase().split('-')[0];
        if (code && targets[code]) { location.replace(targets[code] + location.hash); return; }
      }
      location.replace(fallback + location.hash);
    })();
  </script>
  <main class="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center gap-6 p-6 text-center">
    <p class="text-xl font-bold tracking-tight">{profile.name}</p>
    <ul class="flex flex-wrap justify-center gap-2">
      {
        langs.map((lang) => (
          <li>
            <a href={targets[lang]} hreflang={lang} lang={lang} class="rounded-chip bg-tile px-4 py-2 text-sm font-semibold hover:bg-line">
              {languages[lang].label}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
