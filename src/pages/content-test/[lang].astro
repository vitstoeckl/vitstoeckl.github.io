---
// TEMPORARY content check (Step 2): prints the data in each language at /content-test/{lang}/.
// Delete this folder in Step 3 once the real pages render the data.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langs, languages, pick, t, formatDateRange, formatYearMonth, type Lang } from '../../i18n/utils';
import { profile, cvFileName } from '../../data/profile';
import { experience } from '../../data/experience';
import { education } from '../../data/education';
import { skillGroups } from '../../data/skills';
import { spokenLanguages } from '../../data/languages';
import { projects } from '../../data/projects';
import { certificates } from '../../data/certificates';
import { achievements } from '../../data/achievements';
import { testimonials } from '../../data/testimonials';
import { services } from '../../data/services';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout title={`Content test — ${languages[lang].short}`} lang={lang} noindex>
  <main class="mx-auto grid max-w-4xl gap-4 p-4 sm:p-8">
    <nav class="flex flex-wrap gap-2">
      {langs.map((l) => (
        <a href={url(`/content-test/${l}/`)} class:list={['rounded-chip border border-line px-3 py-1', l === lang && 'bg-ink text-bg']}>
          {languages[l].short}
        </a>
      ))}
    </nav>

    <section class="rounded-tile bg-tile p-8">
      <span class="rounded-chip bg-accent-soft px-3 py-1 text-sm font-semibold text-accent">{pick(profile.status.label, lang)}</span>
      <p class="mt-4 text-muted">{t('hero.greeting', lang)} {profile.name}</p>
      <h1 class="mt-2 text-4xl">{pick(profile.headline, lang)}</h1>
      <p class="mt-2 font-semibold">{pick(profile.title, lang)} · {pick(profile.location, lang)}</p>
      {profile.summary.map((p) => <p class="mt-3 text-muted">{p && pick(p, lang)}</p>)}
      <p class="mt-3">{pick(profile.status.lookingFor, lang)}</p>
      <p class="mt-3 text-sm text-muted">{t('cta.downloadCv', lang)}: {cvFileName(lang)}</p>
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.experience', lang)}</h2>
      {experience.map((e) => (
        <div class="mt-4">
          <p class="font-semibold">{pick(e.role, lang)} — {e.company}</p>
          <p class="text-sm text-muted">{formatDateRange(e.start, e.end, lang)} · {pick(e.location, lang)}</p>
          <ul class="mt-2 list-disc pl-5">{e.bullets.map((b) => <li>{pick(b, lang)}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.education', lang)}</h2>
      {education.map((e) => (
        <div class="mt-4">
          <p class="font-semibold">{pick(e.degree, lang)}, {pick(e.field, lang)} — {e.school}</p>
          <p class="text-sm text-muted">
            {formatDateRange(e.start, e.end, lang)}{e.endExpected && ` (${t('date.expected', lang)})`} · {pick(e.location, lang)}
          </p>
        </div>
      ))}
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.skills', lang)} · {t('section.languages', lang)}</h2>
      {skillGroups.map((g) => (
        <p class="mt-3"><b>{pick(g.title, lang)}:</b> {g.skills.map((s) => <span class:list={['mr-2', s.highlight && 'text-accent font-semibold']}>{pick(s.name, lang)}</span>)}</p>
      ))}
      <p class="mt-3">
        {spokenLanguages.map((l) => (
          <span class="mr-3">
            {pick(l.name, lang)} {l.level === 'native' ? t('level.native', lang) : l.level}
            {l.certified && ` (${t('level.certified', lang, { level: l.certified })})`}
          </span>
        ))}
      </p>
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.projects', lang)}</h2>
      {projects.map((p) => (
        <div class="mt-4">
          <p class="font-semibold">
            {pick(p.title, lang)} · {t(`category.${p.category}`, lang)}{p.featured && ` · ${t('project.featured', lang)}`}
          </p>
          <p>{pick(p.summary, lang)}</p>
          {p.kpi && <p class="text-accent font-semibold">{p.kpi.value} {pick(p.kpi.label, lang)}</p>}
          <p class="mt-1 text-sm"><b>{t('project.result', lang)}:</b> {pick(p.result, lang)}</p>
          {p.links?.map((l) => <a class="text-accent underline" href={l.url}>{t('cta.visit', lang, { site: l.label ?? l.url })} ↗</a>)}
        </div>
      ))}
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.certificates', lang)}</h2>
      <ul class="mt-2 list-disc pl-5">
        {certificates.map((c) => (
          <li>
            {pick(c.name, lang)}{c.issuer && ` — ${t('certificates.issuedBy', lang, { issuer: c.issuer })}`}
            {c.date && ` · ${formatYearMonth(c.date, lang)}`}
          </li>
        ))}
      </ul>
    </section>

    <section class="rounded-tile bg-tile p-8">
      <h2 class="text-2xl">{t('section.services', lang)}</h2>
      {services.map((s) => (
        <div class="mt-4">
          <p class="font-semibold">{pick(s.title, lang)}</p>
          <p class="text-muted">{pick(s.description, lang)}</p>
          <p class="mt-1 text-sm font-semibold">{t('services.includes', lang)}</p>
          <ul class="list-disc pl-5">{s.includes.map((i) => <li>{pick(i, lang)}</li>)}</ul>
          <p class="mt-1 text-accent">{pick(s.cta, lang)}</p>
        </div>
      ))}
      <p class="mt-4 font-semibold">{t('cta.letsTalk', lang)}</p>
    </section>

    <section class="rounded-tile bg-tile-dark p-8 text-tile-dark-ink">
      <h2 class="text-2xl">{t('section.contact', lang)}</h2>
      <p class="mt-2 text-tile-dark-muted">{t('contact.lead', lang)}</p>
      <p class="mt-2">{profile.email} · LinkedIn{profile.socials.github && ' · GitHub'}</p>
      <p class="mt-4 text-sm text-tile-dark-muted">
        {t('section.achievements', lang)}: {achievements.length} · {t('section.testimonials', lang)}: {testimonials.length} (hidden when 0)
      </p>
    </section>
  </main>
</BaseLayout>
